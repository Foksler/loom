#: Email: Magic Link - Subject
msgid "server.email.magic_link.subject"
msgstr "Iniciar sesión en Loom"

#: Email: Magic Link - Body intro
msgid "server.email.magic_link.body"
msgstr "Haz clic en el siguiente enlace para iniciar sesión en tu cuenta de Loom."

#: Email: Magic Link - Expiry notice
msgid "server.email.magic_link.expires"
msgstr "Este enlace expira en {minutes} minutos."

#: Email: Magic Link - Ignore notice
msgid "server.email.magic_link.ignore"
msgstr "Si no solicitaste este correo electrónico, puedes ignorarlo de forma segura."

#: Email: Magic Link - Copy link instruction
msgid "server.email.magic_link.copy_link"
msgstr "O copia y pega este enlace:"

#: Email: Org Invitation - Subject
msgid "server.email.invitation.subject"
msgstr "Te han invitado a unirte a {org_name} en Loom"

#: Email: Org Invitation - Body
msgid "server.email.invitation.body"
msgstr "{inviter_name} te ha invitado a unirte a la organización \"{org_name}\" en Loom."

#: Email: Org Invitation - Action instruction
msgid "server.email.invitation.action"
msgstr "Haz clic en el siguiente enlace para aceptar la invitación:"

#: Email: Org Invitation - No expiry notice
msgid "server.email.invitation.no_expiry"
msgstr "Esta invitación no expira, pero puede ser revocada por el administrador de la organización."

#: Email: Security Alert - Subject
msgid "server.email.security_alert.subject"
msgstr "Alerta de seguridad de Loom: {event}"

#: Email: Security Alert - Body intro
msgid "server.email.security_alert.body"
msgstr "Ocurrió un evento de seguridad en tu cuenta de Loom."

#: Email: Security Alert - Event label
msgid "server.email.security_alert.event"
msgstr "Evento: {event}"

#: Email: Security Alert - Details label
msgid "server.email.security_alert.details"
msgstr "Detalles:"

#: Email: Security Alert - Action instruction
msgid "server.email.security_alert.action"
msgstr "Si no fuiste tú, revisa la configuración de seguridad de tu cuenta inmediatamente."

#: Email: Deletion Warning - Subject
msgid "server.email.deletion_warning.subject"
msgstr "Tu cuenta de Loom está programada para eliminación"

#: Email: Deletion Warning - Body
msgid "server.email.deletion_warning.body"
msgstr "Tu cuenta de Loom está programada para eliminación permanente en {days} días."

#: Email: Deletion Warning - Restore instruction
msgid "server.email.deletion_warning.restore"
msgstr "Si no solicitaste esta eliminación, o si has cambiado de opinión, puedes restaurar tu cuenta iniciando sesión antes de la fecha de eliminación."

#: Email: Deletion Warning - Permanent notice
msgid "server.email.deletion_warning.permanent"
msgstr "Después de la eliminación permanente, tus datos no se pueden recuperar."

#: Email: Deletion Scheduled - Subject
msgid "server.email.deletion_scheduled.subject"
msgstr "Eliminación de cuenta programada"

#: Email: Deletion Scheduled - Body
msgid "server.email.deletion_scheduled.body"
msgstr "Tu cuenta ha sido programada para eliminación."

#: Email: Deletion Scheduled - Grace period notice
msgid "server.email.deletion_scheduled.grace"
msgstr "Tienes {days} días para restaurar tu cuenta iniciando sesión y cancelando la eliminación."

#: Email: Deletion Scheduled - Permanent notice
msgid "server.email.deletion_scheduled.permanent"
msgstr "Después del período de gracia, tu cuenta y todos los datos asociados serán eliminados permanentemente."

#: API: Auth - Check email response
msgid "server.api.auth.check_email"
msgstr "Revisa tu correo electrónico para obtener un enlace de inicio de sesión"

#: API: Auth - Logged out response
msgid "server.api.auth.logged_out"
msgstr "Sesión cerrada exitosamente"

#: API: Error - Internal error
