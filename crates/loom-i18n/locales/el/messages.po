msgid "server.email.security_alert.body"
msgstr "Συνέβη ένα συμβάν ασφαλείας στον λογαριασμό σας στο Loom."

#: Email: Security Alert - Event label
msgid "server.email.security_alert.event"
msgstr "Συμβάν: {event}"

