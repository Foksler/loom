msgid "server.email.invitation.no_expiry"
msgstr "Αυτή η πρόσκληση δεν λήγει, αλλά μπορεί να ανακληθεί από τον διαχειριστή του οργανισμού."

#: Email: Security Alert - Subject
msgid "server.email.security_alert.subject"
msgstr "Ειδοποίηση ασφαλείας Loom: {event}"

