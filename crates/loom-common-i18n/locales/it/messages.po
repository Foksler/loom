#: Email: Magic Link - Subject
msgid "server.email.magic_link.subject"
msgstr "Accedi a Loom"

#: Email: Magic Link - Body intro
msgid "server.email.magic_link.body"
msgstr "Clicca sul link qui sotto per accedere al tuo account Loom."

#: Email: Magic Link - Expiry notice
msgid "server.email.magic_link.expires"
msgstr "Questo link scade tra {minutes} minuti."

#: Email: Magic Link - Ignore notice
msgid "server.email.magic_link.ignore"
