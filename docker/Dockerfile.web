# Multi-stage Docker build for loom-web
# Stage 1: Build Rust/Leptos application
# Stage 2: Serve with nginx

# ===== BUILD STAGE =====
FROM rust:1.70 as builder

# Install required build tools
RUN apt-get update && apt-get install -y \
    curl \
    npm \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js LTS
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs

# Set working directory
WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

# Build the Leptos application in release mode
RUN cd crates/loom-web && \
    npm ci && \
    npm run build

# ===== RUNTIME STAGE =====
FROM nginx:alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Copy nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy built artifacts from builder
COPY --from=builder /app/crates/loom-web/target/release/loom_web /usr/share/nginx/html/

# Create health check script
RUN mkdir -p /docker-entrypoint.d && \
    echo '#!/bin/sh\nset -e\ncurl -f http://localhost:80/ || exit 1' > /health.sh && \
    chmod +x /health.sh

# Expose port
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD /health.sh || exit 1

# Default command (nginx runs as daemon)
CMD ["nginx", "-g", "daemon off;"]
