# Systemd service unit for Loom
# Installation: sudo cp loom.service /etc/systemd/system/
# Enable: sudo systemctl enable loom
# Start: sudo systemctl start loom

[Unit]
Description=Loom Server - AI-powered collaborative development
Documentation=https://github.com/ghuntley/loom
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
# User and group
User=loom
Group=loom
UMask=0077

# Working directory
WorkingDirectory=/opt/loom

# Environment
EnvironmentFile=/etc/loom/loom.env
Environment="RUST_LOG=info"

# Start command
ExecStart=/opt/loom/loom-server
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# Restart policy
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Process management
Type=simple
PIDFile=/run/loom/loom.pid
KillMode=mixed

# Timeout
TimeoutStartSec=30s
TimeoutStopSec=10s

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096
MemoryLimit=1G
CPUQuota=50%

# Security
PrivateTmp=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/loom /var/log/loom /run/loom
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RemoveIPC=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes

# Standard output/error
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loom

[Install]
WantedBy=multi-user.target
