# Loom Environment Configuration Template
# Copy to .env and update with your values for your environment

# ==================== Application ====================
# Application name and version
APP_NAME=loom
APP_VERSION=0.1.0
ENVIRONMENT=production

# Logging configuration
LOG_LEVEL=info
RUST_LOG=loom=info,warn
LOG_FORMAT=json

# ==================== Server ====================
# Server binding
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ADDRESS=${SERVER_HOST}:${SERVER_PORT}

# TLS/SSL Configuration
TLS_ENABLED=true
TLS_CERT_PATH=/etc/loom/tls/cert.pem
TLS_KEY_PATH=/etc/loom/tls/key.pem
TLS_MIN_VERSION=1.2

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_MAX_AGE=86400

# ==================== Database ====================
# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/loom
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
DATABASE_CONNECTION_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=300

# ==================== Cache ====================
# Redis cache
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_POOL_SIZE=10
CACHE_TTL=3600

# ==================== API Keys & Secrets ====================
# LLM Provider Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VERTEX_AI_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1

# GitHub Integration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Google Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ==================== Monitoring & Observability ====================
# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Tracing
TRACING_ENABLED=true
TRACING_JAEGER_ENDPOINT=http://localhost:14268/api/traces
TRACING_SAMPLE_RATE=0.1

# Health Check
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_INTERVAL=30

# ==================== Security ====================
# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Authentication
AUTH_ENABLED=true
AUTH_TIMEOUT=30
SESSION_TIMEOUT=86400

# HTTPS Redirect
HTTPS_REDIRECT=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# ==================== Storage ====================
# File Storage
STORAGE_ENABLED=true
STORAGE_TYPE=s3
STORAGE_PATH=/var/lib/loom/storage

# S3 Configuration (if using S3 storage)
S3_BUCKET=loom-data
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ==================== Email ====================
# SMTP Configuration
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# ==================== Backup & Recovery ====================
# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=gzip
BACKUP_PATH=/var/lib/loom/backups

# ==================== Performance Tuning ====================
# Connection Pooling
POOL_MIN_IDLE=5
POOL_MAX_SIZE=20
POOL_TIMEOUT=30

# Request Limits
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10485760
MAX_BODY_SIZE=5242880

# Worker Threads
WORKER_THREADS=4
BLOCKING_THREADS=512

# ==================== Feature Flags ====================
FEATURE_QUERY_BRIDGE=true
FEATURE_METRICS=true
FEATURE_STREAMING=true
FEATURE_AUTH=true

# ==================== External Services ====================
# Slack Integration
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Stripe (if applicable)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ==================== Deployment ====================
# Deployment Configuration
DEPLOY_ENVIRONMENT=production
DEPLOY_REGION=us-east-1
DEPLOY_VERSION=${APP_VERSION}
DEPLOY_BUILD_ID=

# Graceful Shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=30
SHUTDOWN_SIGNAL=SIGTERM

# ==================== Development Settings ====================
# These should be false in production
DEBUG=false
PRETTY_PRINT_LOGS=false
ALLOW_CORS_LOCALHOST=false
ENABLE_PLAYGROUND=false
ENABLE_INTROSPECTION=false
