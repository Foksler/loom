{
  "dashboard": {
    "title": "Loom Server Monitoring",
    "description": "Production monitoring dashboard for Loom server",
    "tags": ["loom", "production", "monitoring"],
    "timezone": "utc",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Server Status",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "expr": "up{job=\"loom-server\"}"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "background"
        }
      },
      {
        "id": 2,
        "title": "Uptime",
        "type": "stat",
        "gridPos": {
          "x": 4,
          "y": 0,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "expr": "time() - process_start_time_seconds{job=\"loom-server\"}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "id": 3,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {
          "x": 8,
          "y": 0,
          "w": 8,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"loom-server\"}[5m])) by (method)"
          }
        ],
        "yaxes": [
          {
            "format": "rps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 4,
        "title": "HTTP Status Distribution",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"loom-server\"}[5m])) by (status)"
          }
        ],
        "legend": {
          "show": true,
          "values": ["current", "total", "avg"]
        }
      },
      {
        "id": 5,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {
          "x": 6,
          "y": 4,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{job=\"loom-server\",status=~\"5..\"}[5m]))"
          }
        ],
        "yaxes": [
          {
            "format": "rps"
          }
        ]
      },
      {
        "id": 6,
        "title": "Response Time (P95)",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 4,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"loom-server\"}[5m])) by (le))"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          }
        ]
      },
      {
        "id": 7,
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "(1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))) * 100"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "max": 100
          }
        ]
      },
      {
        "id": 8,
        "title": "Memory Usage",
        "type": "graph",
        "gridPos": {
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "max": 100
          }
        ]
      },
      {
        "id": 9,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "db_pool_connections_in_use"
          }
        ]
      },
      {
        "id": 10,
        "title": "Database Query Time",
        "type": "graph",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket[5m])) by (le))"
          }
        ],
        "yaxes": [
          {
            "format": "s"
          }
        ]
      },
      {
        "id": 11,
        "title": "Cache Hit Ratio",
        "type": "gauge",
        "gridPos": {
          "x": 6,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "cache_hits / (cache_hits + cache_misses) * 100"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        }
      },
      {
        "id": 12,
        "title": "Active Connections",
        "type": "stat",
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "sum(http_connections_active{job=\"loom-server\"})"
          }
        ]
      },
      {
        "id": 13,
        "title": "Logs",
        "type": "logs",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 8
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "showCommonLabels": false
        }
      }
    ]
  }
}
